<?xml version="1.0" encoding="utf-8"?>
<automotiveApp xmlns:tools="http://schemas.android.com/tools">
        <!--
            Fermata-style capabilities: media + service + projection + video.
            No notification (empty message surface). No template.
            Live TV / YouTube / Google are media browse items like radio.
        -->
    <uses
        name="projection"
        tools:ignore="InvalidUsesTagAttribute" />
    <uses name="video" />
    <uses
        name="service"
        tools:ignore="InvalidUsesTagAttribute" />
    <uses name="media" />
    <!-- <uses name="template" /> -->
</automotiveApp>
