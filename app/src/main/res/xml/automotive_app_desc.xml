<?xml version="1.0" encoding="utf-8"?>
<automotiveApp xmlns:tools="http://schemas.android.com/tools">
    <!--
        Projection is the launcher surface (CarVideoActivity in
        CarActivity.g). Media is radio now-playing only so Android
        Auto does not open a browse tree of Canlı TV / YouTube /
        Google that renders as Öğe yok.
        Template stays commented out (Fermata).
        video: park/OEM host video capability for SurfaceView.
    -->
    <uses
        name="projection"
        tools:ignore="InvalidUsesTagAttribute" />
    <uses name="video" />
    <uses
        name="service"
        tools:ignore="InvalidUsesTagAttribute" />
    <uses name="media" />
    <!-- <uses name="template" /> -->
</automotiveApp>
