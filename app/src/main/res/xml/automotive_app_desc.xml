<?xml version="1.0" encoding="utf-8"?>
<automotiveApp xmlns:tools="http://schemas.android.com/tools">
    <!--
        Fermata and CarStream advertise projection + media + service.
        Template stays commented out so the host opens CarActivity, not
        a NavigationTemplate. Live TV / YouTube / Google are not media
        browse children (that path was Öğe yok). Media root is radio
        only. video: park/OEM host SurfaceView capability.
    -->
    <uses
        name="projection"
        tools:ignore="InvalidUsesTagAttribute" />
    <uses name="video" />
    <uses
        name="service"
        tools:ignore="InvalidUsesTagAttribute" />
    <uses name="notification" />
    <uses name="media" />
    <!-- <uses name="template" /> -->
</automotiveApp>
