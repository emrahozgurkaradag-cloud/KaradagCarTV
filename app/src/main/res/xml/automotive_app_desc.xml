<?xml version="1.0" encoding="utf-8"?>
<!--
    Android Auto uygulama tanımı (play / Google Play yapısı).

    media: CarMediaService (Media3 MediaLibraryService) — Canlı Radyo ve
    Canlı TV kanallarının SESİ, sürüşte ve parkta Android Auto'nun
    resmî medya arayüzünde.

    Park hâlinde video, bu dosyayla DEĞİL, <application
    android:appCategory="video"> ile bildirilir. Google'ın parked-apps
    kuralı: video uygulamaları burada <uses name="video"/> TAŞIMAZ.
    "template", "service", "projection" girişleri resmî olmayan
    sideloadLegacy yapısına aittir (app/src/sideloadLegacy/res/xml).
-->
<automotiveApp>
    <uses name="media" />
</automotiveApp>
