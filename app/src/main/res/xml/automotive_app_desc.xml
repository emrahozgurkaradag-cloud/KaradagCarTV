<?xml version="1.0" encoding="utf-8"?>
<automotiveApp xmlns:tools="http://schemas.android.com/tools">
    <!--
        Projection is the only Android Auto launcher surface.
        Media browse (MediaBrowserService) is not advertised so the
        host cannot open a radio/TV list instead of CarVideoActivity.
        CarMediaService still runs in-process for ExoPlayer.
        Template stays commented out (Fermata).
        video: park/OEM host video capability for SurfaceView.
    -->
    <uses
        name="projection"
        tools:ignore="InvalidUsesTagAttribute" />
    <uses name="video" />
    <uses
        name="service"
        tools:ignore="InvalidUsesTagAttribute" />
    <!-- <uses name="media" /> -->
    <!-- <uses name="template" /> -->
</automotiveApp>
