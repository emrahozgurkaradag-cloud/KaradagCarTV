<?xml version="1.0" encoding="utf-8"?>
<automotiveApp xmlns:tools="http://schemas.android.com/tools">
    <!--
        Current Fermata: media + service + projection. No notification
        (that tag made AA open the empty message surface). No template.
        video: park/OEM host SurfaceView capability.
        Live TV / YouTube / Google render in CarActivity.g. Media
        browse is radio stations only (empty hosted folders were
        Öğe yok).
    -->
    <uses
        name="projection"
        tools:ignore="InvalidUsesTagAttribute" />
    <uses name="video" />
    <uses
        name="service"
        tools:ignore="InvalidUsesTagAttribute" />
    <uses name="media" />
    <!-- <uses name="template" /> -->
</automotiveApp>
