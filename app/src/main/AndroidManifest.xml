<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        Fermata Auto flavor declares automotive required=true because
        that APK is the Auto build. This is a phone APK that also
        projects. Gearhead discovers us via CATEGORY_PROJECTION, not
        this feature. required=false keeps the APK installable on
        phones (Fermata issue #580 set it false for wireless).
    -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <!--
        aauto.aar gms.car.g loads DynamicApiFactory from the Gearhead
        package. Android 11+ needs this query or CarActivityService
        onCreate fails with "Error loading car activity host".
    -->
    <queries>
        <package android:name="com.google.android.projection.gearhead" />
        <package android:name="com.google.android.gms" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KaradagCarTV"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <meta-data
            android:name="com.google.android.gms.car.notification.SmallIcon"
            android:resource="@mipmap/ic_launcher" />

        <meta-data
            android:name="com.google.android.gms.car.application.theme"
            android:resource="@style/Theme.KaradagCarTV" />

        <activity
            android:name=".PhoneActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.KaradagCarTV">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fermata Media Service: unique label + icon, MediaBrowserService -->
        <service
            android:name=".CarMediaService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:icon="@drawable/ic_media_service"
            android:label="@string/media_service_name">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
            </intent-filter>
        </service>

        <!-- Fermata CarService: MAIN + CATEGORY_PROJECTION + OEM, app_name -->
        <service
            android:name=".CarVideoService"
            android:exported="true"
            android:label="@string/app_name"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION" />
                <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION_OEM" />
            </intent-filter>
        </service>

    </application>

</manifest>
