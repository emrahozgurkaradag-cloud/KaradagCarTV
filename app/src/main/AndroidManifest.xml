<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.INTERNET" />

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission
        android:name="android.permission.WAKE_LOCK" />

    <!--
        Google Play (Android Auto / Android Automotive OS) dağıtımı:
        Telefon zorunlu donanımı yoktur; aynı APK, Google built-in
        (Android Automotive OS) araçlarda da kurulabilir. Bu özellikler
        "required=false" olmalıdır (car-app-quality DO-1).
    -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Karadag Car TV"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KaradagCarTV"
        android:appCategory="video"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!--
            Google'ın park hâlinde video kategorisi (Android Automotive
            OS'ta genel, Android Auto'da beta / erken erişim).
            android:appCategory="video" yukarıda <application> üzerinde.
            Video uygulamaları "distractionOptimized" meta-data'sı
            TAŞIMAZ; sürüşe geçildiğinde sistem aktiviteyi örter ve
            onPause/onStop çağırır, PlayerActivity videoyu durdurur.
            Uyumluluk modunda (display compatibility) çalışmaya izin ver:
        -->
        <meta-data
            android:name="android.software.car.display_compatibility"
            android:value="true" />

        <meta-data
            android:name="com.google.android.gms.car.notification.SmallIcon"
            android:resource="@mipmap/ic_launcher" />

        <!-- ====================================================== -->
        <!-- TELEFON UYGULAMASI                                    -->
        <!-- ====================================================== -->

        <activity
            android:name=".RegistrationActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:label="Karadag Car TV"
            android:theme="@style/Theme.KaradagCarTV"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

                <category
                    android:name="android.intent.category.CAR_LAUNCHER" />

            </intent-filter>

        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:label="Karadag Car TV"
            android:theme="@style/Theme.KaradagCarTV"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".YouTubeActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".IptvActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:windowSoftInputMode="adjustResize" />

        <!-- ====================================================== -->
        <!-- ANDROID AUTO MEDIA SERVICE                             -->
        <!-- ====================================================== -->

        <service
            android:name=".CarMediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">

            <intent-filter>

                <action
                    android:name="androidx.media3.session.MediaLibraryService" />

                <action
                    android:name="android.media.browse.MediaBrowserService" />

                <action
                    android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />

            </intent-filter>

        </service>

        <!--
            Android Auto ekran yansıtma (MediaProjection), NAVIGATION
            kategorisi kötüye kullanımı ve aauto.aar CarActivity yolu (araç ekranında video)
            Google tarafından üçüncü taraf uygulamalara açık değildir.
            Bunlar yalnızca resmî olmayan projection yapı türündedir:
            app/src/projection/AndroidManifest.xml
        -->

    </application>

</manifest>