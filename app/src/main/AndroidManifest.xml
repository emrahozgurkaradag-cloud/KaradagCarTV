<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.INTERNET" />

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <uses-permission
        android:name="androidx.car.app.ACCESS_SURFACE" />

    <uses-permission
        android:name="androidx.car.app.NAVIGATION_TEMPLATES" />

    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission
        android:name="android.permission.WAKE_LOCK" />

    <!--
        Android 11+ package visibility: uygulama Android Auto host
        paketini görebilir. Host'un bu uygulamayı keşfetmesi exported
        servisler + automotive_app_desc üzerinden olur.
    -->
    <queries>
        <package android:name="com.google.android.projection.gearhead" />
        <package android:name="com.google.android.gms" />
        <intent>
            <action android:name="androidx.car.app.CarAppService" />
        </intent>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Karadag Car TV"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KaradagCarTV"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!--
            Android Auto (androidx.car.app / Car App Library) host,
            CarAppService.onBind() sırasında bu değeri manifest'te
            bulamazsa "Min API level not declared in manifest"
            hatasıyla bağlanmayı reddediyor ve CarMirrorService
            (Mirror / MediaProjection ekranı) hiç açılmıyordu.
            Kullanılan tüm Car App Library API'leri (NavigationTemplate,
            ActionStrip, SurfaceCallback) seviye 1'de mevcut olduğu için
            en geniş uyumluluk için 1 olarak bırakıldı.
        -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <meta-data
            android:name="com.google.android.gms.car.notification.SmallIcon"
            android:resource="@mipmap/ic_launcher" />

        <!-- ====================================================== -->
        <!-- TELEFON UYGULAMASI                                    -->
        <!-- ====================================================== -->

        <activity
            android:name=".RegistrationActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize"
            android:label="Karadag Car TV"
            android:theme="@style/Theme.KaradagCarTV"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

                <category
                    android:name="android.intent.category.CAR_LAUNCHER" />

            </intent-filter>

        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize"
            android:label="Karadag Car TV"
            android:theme="@style/Theme.KaradagCarTV"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".YouTubeActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".IptvActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize"
            android:windowSoftInputMode="adjustResize" />

        <!-- ====================================================== -->
        <!-- MEDIAPROJECTION İZİN EKRANI                           -->
        <!-- ====================================================== -->

        <activity
            android:name=".MediaProjectionPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.KaradagCarTV" />

        <!-- ====================================================== -->
        <!-- ANDROID AUTO MEDIA SERVICE                             -->
        <!-- ====================================================== -->

        <service
            android:name=".CarMediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">

            <intent-filter>

                <action
                    android:name="androidx.media3.session.MediaLibraryService" />

                <action
                    android:name="android.media.browse.MediaBrowserService" />

                <action
                    android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />

            </intent-filter>

        </service>

        <!--
            Mirror is phone-initiated MediaProjection, not the Android Auto
            launcher. An exported CarAppService with the same label as
            CarVideoService lets the host open an empty NavigationTemplate
            instead of CarActivity.g.
        -->
        <service
            android:name=".CarMirrorService"
            android:exported="false"
            android:label="Karadag Mirror" />

        <!-- ====================================================== -->
        <!-- FERMATA TİPİ CAR ACTIVITY SERVICE                     -->
        <!-- ====================================================== -->

        <service
            android:name=".CarVideoService"
            android:exported="true"
            android:label="Karadag Car TV">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION" />

                <category
                    android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION_OEM" />

            </intent-filter>

        </service>

        <!-- ====================================================== -->
        <!-- MEDIAPROJECTION SERVİSİ                                -->
        <!-- ====================================================== -->

        <service
            android:name=".MirrorProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>

</manifest>