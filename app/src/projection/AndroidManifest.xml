<?xml version="1.0" encoding="utf-8"?>
<!--
    projection — Android Auto araç ekranında GÖRÜNTÜLÜ oynatma.

    ./gradlew assembleProjectionRelease ile main manifest'e eklenir.
    Yöntem (Fermata Auto / AA Car Play Video ile aynı aile):
      * CarVideoService: CATEGORY_PROJECTION(_OEM) + aauto.aar
        CarActivity -> araç ekranında pencere, ExoPlayer SurfaceView.
      * CarMirrorService: Car App Library NAVIGATION şablonu yüzeyi +
        MediaProjection (telefon ekranı yansıtma).
    Bunlar Google'ın resmî üçüncü taraf API'leri DEĞİLDİR. Bir
    kullanıcının AA 17.7 analizine göre (Fermata #846/#847, bu projede
    doğrulanmadı) PROJECTION/TEMPLATE türleri "Bilinmeyen kaynaklar" ile
    açılmaz; Play yükleyicisi (iç/kapalı test) veya geliştirici head
    unit gerekir.
    Sürüşte görüntü park kilidiyle kapatılır (DrivingSafetyGate).
-->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <uses-permission
        android:name="androidx.car.app.ACCESS_SURFACE" />

    <!-- Park kilidi: ekran yansıtma yalnızca araç hızı ~0 iken. -->
    <uses-permission
        android:name="com.google.android.gms.permission.CAR_SPEED" />

    <uses-permission
        android:name="androidx.car.app.NAVIGATION_TEMPLATES" />

    <queries>
        <package android:name="com.google.android.projection.gearhead" />
        <package android:name="com.google.android.gms" />
        <intent>
            <action android:name="androidx.car.app.CarAppService" />
        </intent>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION" />
        </intent>
    </queries>

    <application
        android:label="Karadag Car TV (Araç Video)"
        tools:replace="android:label">

        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <activity
            android:name=".MediaProjectionPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.KaradagCarTV" />

        <service
            android:name=".CarMirrorService"
            android:exported="true"
            android:label="Karadag Car TV">

            <intent-filter>

                <action
                    android:name="androidx.car.app.CarAppService" />

                <category
                    android:name="androidx.car.app.category.NAVIGATION" />

            </intent-filter>

        </service>

        <service
            android:name=".CarVideoService"
            android:exported="true"
            android:label="Karadag Car TV">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION" />

                <category
                    android:name="com.google.android.gms.car.category.CATEGORY_PROJECTION_OEM" />

            </intent-filter>

        </service>

        <service
            android:name=".MirrorProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>

</manifest>
